model ChatMessage {
  id String @id @default(uuid())

  text String

  user User? @relation("user_chatmessages", fields: [userId], references: [id])
  userId String?

  // chatRoom ChatRoom? @relation("chatroom_chatmessages", fields: [chatRoomId], references: [id])
  // chatRoomId String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_message")
}