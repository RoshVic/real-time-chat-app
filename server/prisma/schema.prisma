generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email String @unique
  password String

  name String?
  role UserRole @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  chatMessages ChatMessage[] @relation("user_chatmessages")

  // chatRooms ChatRoom[] @relation("users_and_chatrooms")

  // ownedChatRooms ChatRoom[] @relation("chatroom_owner")
}

  enum UserRole {
    USER
    ADMIN
  }

